{
	admin off
}

:{$PORT:10000} {
	encode gzip zstd

	header {
		-X-Frame-Options
		-Content-Security-Policy
	}

	route {
		# WebSocket do servidor do jogo
		reverse_proxy /game/* 127.0.0.1:8091

		# PocketBase cuida das APIs e de servir o frontend estático compilado
		reverse_proxy 127.0.0.1:8090
	}
}
