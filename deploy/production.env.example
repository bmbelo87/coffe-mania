# Copie para /etc/coffe/production.env (dono root, modo 640, grupo coffe).
# Os dois serviços leem este arquivo pelo systemd. O servidor recusa iniciar se as opções
# obrigatórias de produção estiverem erradas (database/production.go).

COFFE_ENV=production

# Obrigatórias em produção.
COFFE_SECURE_COOKIES=true
COFFE_DEV_TOOLS=false
COFFE_DEV_SEED=false
# Cabeçalho que o Caddy preenche com o IP real (deploy/Caddyfile). Só é seguro porque o
# PocketBase escuta em 127.0.0.1.
COFFE_TRUSTED_PROXY_HEADER=X-Real-IP

# Endereço público (links dos emails) e contato publicado nos Termos e na Privacidade.
COFFE_PUBLIC_URL=https://jogo.example.com
COFFE_CONTACT_EMAIL=contato@example.com

# Email transacional (confirmação da lista de espera, convites e nova senha).
# Brevo, Resend, Amazon SES… Porta 587 usa STARTTLS; 465, TLS direto.
COFFE_SMTP_HOST=smtp.example.com
COFFE_SMTP_PORT=587
COFFE_SMTP_USERNAME=
COFFE_SMTP_PASSWORD=
COFFE_MAIL_FROM=convites@example.com

# Cloudflare Turnstile (anti-robô da lista de espera e de "esqueci minha senha").
COFFE_TURNSTILE_SITE_KEY=
COFFE_TURNSTILE_SECRET=

# Caminhos.
COFFE_PUBLIC_DIR=/opt/coffe/public
COFFE_GAME_SECRET_FILE=/var/lib/coffe/game-secret

# Ligação entre os serviços (só local).
COFFE_BACKEND_URL=http://127.0.0.1:8090
COFFE_GAME_URL=http://127.0.0.1:8091
COFFE_GAME_ADDR=127.0.0.1:8091

# Backup diário do PocketBase às 4h (UTC), guardando os 7 últimos em pb_data/backups.
# O Litestream (deploy/litestream.yml) copia o banco para fora da máquina continuamente.
COFFE_BACKUP_CRON=0 4 * * *
COFFE_BACKUP_KEEP=7
